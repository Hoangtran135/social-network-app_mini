{
  "info": {
    "name": "Social Network Mini API",
    "description": "Tất cả API của server. Chạy \"Login\" (hoặc \"Register\") trước: token được lưu tự động vào biến {{token}} và gửi kèm dạng Bearer cho mọi request.\nCác request tạo dữ liệu (tạo bài viết, bình luận, story, hội thoại...) tự lưu id vào biến để các request sau dùng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "myUserId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "storyId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
