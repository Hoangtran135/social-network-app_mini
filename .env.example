PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/social-network-app

# Required in production — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Comma-separated list of allowed frontend origins in production (e.g. https://a2t.io.vn,https://www.a2t.io.vn)
CORS_ORIGIN=

# Optional — SMTP for password-reset emails. If unset, reset links are logged to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SocialNet <no-reply@a2t.io.vn>
